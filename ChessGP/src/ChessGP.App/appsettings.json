{
  "Data": {
    "path": "data/train.pgn",
    "format": "PGN",
    "labeling": {
      "onlyDecisive": true,
      "winnerMovesOnly": true,
      "labelAllMovesInDraws": false
    },
    "filters": {
      "minLegalMoves": 1,
      "phase": "Any"
    }
  },
  "Stage1": {
    "population": 100,
    "crossoverRate": 0.75,
    "mutationRate": 0.03,
    "generations": 200,
    "batchSize": 5000,
    "ply": 1
  },
  "Stage2": {
    "population": 10,
    "crossoverRate": 0.75,
    "mutationRate": 0.03,
    "generations": 50,
    "gamesPerPair": 4,
    "openingBookPath": "data/openings.fens",
    "useHallOfFame": false,
    "hallOfFameSize": 8,
    "searchDepth": 4,
    "searchMode": "FixedDepth",
    "timePerMoveMs": 0,
    "perMoveNodeCap": 3000000
  },
  "GA": {
    "selectionType": "tournament",
