      {
        "name": "Material.Pawn.MG",
        "bitWidth": 6,
        "min": 0,
        "max": 63,
        "constraintFlags": []
      }
    ]
  },
  "Rng": { "seed": 42 },
  "Output": {
    "checkpointsDir": "artifacts/checkpoints",
    "metricsFile": "artifacts/metrics.csv"
  }
}
